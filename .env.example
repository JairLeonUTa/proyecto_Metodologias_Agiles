# Copia a .env y configura valores propios. No subir .env a Git.
# SQL Server exige una contraseña compleja. Evita ; en la contraseña SQL.
SIHA_SQL_PASSWORD=
SIHA_RABBITMQ_PASSWORD=
# Clave aleatoria de al menos 32 bytes, compartida por A, B y Gateway.
SIHA_JWT_KEY=
SIHA_ADMIN_PASSWORD=
# Sprint 2 (perfil sprint23): modelos de Ollama. Opcional; estos son los valores por defecto.
# Un modelo más pequeño (p. ej. qwen2.5:1.5b) sirve en equipos con poca RAM.
SIHA_OLLAMA_MODELO=llama3.2:3b
SIHA_OLLAMA_MODELO_EMBEDDINGS=nomic-embed-text
