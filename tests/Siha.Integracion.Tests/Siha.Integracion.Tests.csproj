<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas con INFRAESTRUCTURA REAL (no simulada): SQL Server 2022 y RabbitMQ 3.13 en contenedores
    Docker levantados por Testcontainers, el Microservicio B real (WebApplicationFactory) y un
    suscriptor RabbitMQ independiente. Requieren Docker en ejecución.

    Todas llevan el rasgo Categoria=InfraestructuraReal, de modo que:
      dotnet test SIHA-IA.sln con filtro Categoria!=InfraestructuraReal : solo pruebas simuladas
      dotnet test SIHA-IA.sln con filtro Categoria=InfraestructuraReal  : solo infraestructura real
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.11.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Siha.MsB.Api\Siha.MsB.Api.csproj" />
    <!-- Alias: Siha.MsA.Api también define 'Program'; solo se usa su DbContext para migrar DB A. -->
    <ProjectReference Include="..\..\src\Services\Siha.MsA.Api\Siha.MsA.Api.csproj" Aliases="msa" />
  </ItemGroup>

</Project>
